/* 奶龙投稿助手 全局样式模板，占位符由 theme.py 运行时替换 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #3A3438;
    outline: none;
}

QMainWindow, QWidget#centralRoot {
    background: #F8F6F8;
}

/* ---------- 页头 ---------- */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #2E282C;
}

/* ---------- 顶栏 ---------- */
QWidget#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E7E2E7;
}
QLabel#appTitle {
    font-size: 17px;
    font-weight: bold;
    color: {primary};
}
QPushButton#linkBtn {
    background: transparent;
    border: 1px solid #E7E2E7;
    border-radius: 6px;
    padding: 5px 14px;
    color: #5A5258;
}
QPushButton#linkBtn:hover {
    color: {primary};
    border-color: {primary};
    background: {primary_light};
}
QFrame#promoBtn {
    background: {primary};
    border: none;
    border-radius: 8px;
}
QFrame#promoBtn:hover {
    background: {primary_hover};
}
QFrame#promoBtn:pressed {
    background: {primary_hover};
}
QLabel#promoTitle {
    color: {text_on_primary};
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}
QLabel#promoSub {
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    background: transparent;
}
QLabel#mailBadgeOk {
    background: #2F9E44;
    color: #FFFFFF;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
}
QLabel#mailBadgeWarn {
    background: #E03131;
    color: #FFFFFF;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
}

/* ---------- 侧栏 ---------- */
QWidget#sideBar {
    background: #FFFFFF;
    border-right: 1px solid #E7E2E7;
}
QListWidget#navList {
    background: transparent;
    border: none;
    font-size: 13px;
}
QListWidget#navList::item {
    height: 38px;
    padding-left: 14px;
    border-radius: 8px;
    margin: 2px 10px;
    color: #5A5258;
    border-left: 3px solid transparent;
}
QListWidget#navList::item:hover {
    background: #F2EDF1;
}
QListWidget#navList::item:selected {
    background: {primary_light};
    color: {primary};
    font-weight: bold;
    border-left: 3px solid {primary};
}

/* ---------- 卡片 ---------- */
QFrame#card, QWidget#card {
    background: #FFFFFF;
    border: 1px solid #E7E2E7;
    border-radius: 10px;
}
QLabel#cardTitle {
    font-size: 15px;
    font-weight: bold;
    color: #2E282C;
}
QLabel#hintText {
    color: #A0989E;
    font-size: 12px;
}
QFrame#statBar {
    background: {primary};
    border: none;
    border-radius: 2px;
}
QLabel#statNumber {
    font-size: 26px;
    font-weight: bold;
    color: {primary};
}
QLabel#statTitle {
    color: #A0989E;
    font-size: 12px;
}
QFrame#infoBar {
    background: {primary_light};
    border: none;
    border-radius: 6px;
}
QLabel#infoBarText {
    color: {primary};
    font-size: 12px;
}

/* ---------- 按钮体系 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #DCD6DC;
    border-radius: 6px;
    padding: 5px 16px;
    min-height: 24px;
}
QPushButton:hover {
    border-color: {primary};
    color: {primary};
}
QPushButton:pressed {
    background: {primary_light};
}
QPushButton:disabled {
    color: #B8B0B6;
    border-color: #E7E2E7;
    background: #F4F1F4;
}
QPushButton#primaryBtn {
    background: {primary};
    color: {text_on_primary};
    border: none;
    font-weight: bold;
}
QPushButton#primaryBtn:hover {
    background: {primary_hover};
}
QPushButton#primaryBtn:pressed {
    background: {primary_hover};
}
QPushButton#primaryBtn:disabled {
    background: #D8D0D6;
    color: #FFFFFF;
}
QPushButton#dangerBtn {
    color: #E03131;
    border: 1px solid #F1C2C2;
    background: #FFFFFF;
}
QPushButton#dangerBtn:hover {
    background: #FBE7E7;
    color: #E03131;
    border-color: #E03131;
}
QPushButton#iconBtn {
    background: transparent;
    border: none;
    padding: 2px 8px;
    color: {primary};
    min-height: 0;
    min-width: 44px;
}
QPushButton#iconBtn:hover {
    background: {primary_light};
    border-radius: 4px;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QComboBox, QSpinBox, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background: #FFFFFF;
    border: 1px solid #DCD6DC;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: {primary};
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateTimeEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {primary};
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDateTimeEdit:disabled, QTextEdit:disabled {
    background: #F4F1F4;
    color: #B8B0B6;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url({arrow_down});
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E7E2E7;
    selection-background-color: {primary_light};
    selection-color: {primary};
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 2px 8px;
}
/* SpinBox 上下按钮：显式 subcontrol 定位，保证上下热区都在 */
QSpinBox, QDoubleSpinBox {
    padding-right: 26px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    border-left: 1px solid #E3DCE3;
    background: transparent;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border: none;
    border-left: 1px solid #E3DCE3;
    background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: {primary_light};
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url({arrow_up});
    width: 8px;
    height: 8px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url({arrow_down});
    width: 8px;
    height: 8px;
}
QCheckBox {
    spacing: 6px;
}QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C8C0C6;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: {primary};
    border-color: {primary};
    image: none;
}
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #C8C0C6;
    border-radius: 8px;
    background: #FFFFFF;
}
QRadioButton::indicator:checked {
    background: {primary};
    border: 3px solid #FFFFFF;
    background-clip: content;
}

/* ---------- 表格 ---------- */
QTableWidget, QTableView {
    background: #FFFFFF;
    border: 1px solid #E7E2E7;
    border-radius: 8px;
    gridline-color: #EFEBEF;
    selection-background-color: {primary_light};
    selection-color: #3A3438;
    alternate-background-color: #FBF9FB;
}
QTableWidget::item, QTableView::item {
    padding: 6px;
    border: none;
}
QTableWidget::item:hover, QTableView::item:hover {
    background: {primary_light};
}
QHeaderView::section {
    background: #F5F3F6;
    color: #7A7278;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid #E7E2E7;
}

/* ---------- 徽章（状态/判定） ---------- */
QLabel#badge {
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 12px;
}
QLabel#badge[kind="pass"]      { background: #E5F4E9; color: #2F9E44; }
QLabel#badge[kind="reject"]    { background: #FBE7E7; color: #E03131; }
QLabel#badge[kind="revise"]    { background: #FDECE0; color: #E8590C; }
QLabel#badge[kind="other"]     { background: #F0EDF0; color: #8A8087; }
QLabel#badge[kind="sent"]      { background: {primary_light}; color: {primary}; }
QLabel#badge[kind="fail"]      { background: #FBE7E7; color: #E03131; }
QLabel#badge[kind="scheduled"] { background: #EEEAFB; color: #7048E8; }
QLabel#badge[kind="pending"]   { background: #F0EDF0; color: #8A8087; }

/* ---------- 标签页（下划线式） ---------- */
QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #E7E2E7;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #7A7278;
    padding: 8px 20px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #3A3438;
}
QTabBar::tab:selected {
    color: {primary};
    font-weight: bold;
    border-bottom: 2px solid {primary};
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #D5CDD5;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #B8AEB8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #D5CDD5;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #B8AEB8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 其他 ---------- */
QToolTip {
    background: #FFFFFF;
    color: #3A3438;
    border: 1px solid #E7E2E7;
    border-radius: 6px;
    padding: 6px 8px;
}
QGroupBox {
    border: 1px solid #E7E2E7;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: {primary};
}
QProgressBar {
    background: #F0EDF0;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: {primary};
    border-radius: 5px;
}
QDateTimeEdit::drop-down {
    border: none;
    width: 24px;
}
QDateTimeEdit::down-arrow {
    image: url({arrow_down});
    width: 10px;
    height: 10px;
}
